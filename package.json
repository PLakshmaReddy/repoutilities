{
  "name": "bitbucket-repo-manager",
  "version": "1.0.0",
  "description": "UI application to manage Bitbucket repositories",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run start\" \"npm run client\""
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "^3.995.0",
    "@aws-sdk/client-secrets-manager": "^3.995.0",
    "@aws-sdk/client-securityhub": "^3.995.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "diff": "^8.0.3",
    "express": "^5.2.1",
    "simple-git": "^3.32.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
