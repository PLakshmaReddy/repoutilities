{
  "name": "bitbucket-repo-manager",
  "version": "1.0.0",
  "description": "UI application to manage Bitbucket repositories",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run start\" \"npm run client\""
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-securityhub": "^3.700.0",
    "axios": "^1.7.0",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
